    "dialMarker": "320ms",
    "barFill": "340ms",
    "rowIn": "300ms",
    "feedback": "80-140ms"
  },
  "components": ["Dial", "Reading", "SectionMark", "KillBar", "KillPad", "StepScale", "Mark", "Notice"],
