{
  "version": 1,
  "colors": {
    "paper": "#f3efe6",
    "paperTop": "#f7f4ec",
    "paperSunk": "#ebe5d8",
    "ink": "#15130d",
    "ink2": "#3d3830",
    "ink3": "#6a6459",
    "ink4": "#a29b8d",
    "rule": "#d8d1c1",
    "rule2": "#c3bba9",
    "signal": "#c8402a",
    "signalInk": "#8e2a1a",
    "signalWash": "#f6ded6",
    "confirm": "#0e6659",
    "confirmWash": "#dcece7",
    "focus": "#135e8c"
  },
  "roles": {
    "signal": "the actionable sensitivity, the current step, a primary action",
    "confirm": "a value the search accepted",
    "focus": "focus rings only"
  },
  "typography": {
    "sans": "'Segoe UI Variable Display', 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', system-ui, sans-serif",
    "mono": "'Cascadia Mono', 'Consolas', 'SF Mono', ui-monospace, 'Menlo', monospace",
